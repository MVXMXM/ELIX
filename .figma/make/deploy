#!/usr/bin/env bash
set -euo pipefail

rm -rf dist
mkdir -p dist/assets dist/icons
cp index.html dist/index.html
cp icons/elix.svg icons/elix-wordmark.svg dist/icons/
cp public/assets/github.svg public/assets/external-link.svg dist/assets/
[[ -d "dist" ]] || {
  echo "Expected build output at dist" >&2
  exit 1
}
figma make deploy --build-dir "dist"
